# GEMINI_API_KEY: Required for server-side Gemini Vision and natural-language guide queries.
# Configure this via your environment or Settings > Secrets.
GEMINI_API_KEY=

# APP_URL: Public base URL where the application is hosted (used for CORS allowlist and canonical links).
APP_URL=

# ADMIN_EMAIL: Primary administrator email address (defaults to prst4550@gmail.com if omitted).
ADMIN_EMAIL=

# ADMIN_PASSCODE: Server-side administrator password/passcode.
# If unset on first launch, use the in-app first-run administrator setup form to claim the account.
ADMIN_PASSCODE=

# SESSION_SECRET: Optional secret used for session integrity (an in-memory random secret is generated if omitted).
SESSION_SECRET=

# TRUST_PROXY: Set only when running behind a reverse proxy (e.g. "1" for one hop), so client IPs
# are read from X-Forwarded-For. Leave empty otherwise - it would let clients spoof IPs and bypass rate limits.
TRUST_PROXY=
